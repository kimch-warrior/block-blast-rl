# This repository contains the standalone local game and RL runtime.
# Unused framework scaffolding in the working directory stays local.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/README.md
!/API.md
!/RL.md
!/LICENSE*
!/package.json
!/package-lock.json
!/Dockerfile
!/compose.yaml
!/start-local.cmd
!/stop-local.cmd
!/.github/

!/public/
/public/*
!/public/game/
!/server/

!/app/
/app/*
!/app/api/
/app/api/*
!/app/api/_lib/
/app/api/_lib/*
!/app/api/_lib/service.js
!/app/api/_lib/score-migration.js

!/docker/
/docker/*
!/docker/runtime-package.json
!/examples/
/examples/*
!/examples/rl-client.mjs
!/scripts/
/scripts/*
!/scripts/benchmark-rl.mjs
!/tests/
/tests/*
!/tests/*.test.mjs

# Local data, credentials and artifacts must never be committed.
**/node_modules/
**/data/
**/outputs/
**/coverage/
**/.openai/
**/.codex/
**/.agents/
**/.sites-runtime/
**/.wrangler/
.env*
.dev.vars*
*.pem
*.key
*.sqlite*
*.db
*.apk
*.zip
*.tar
*.tar.gz
*.tsbuildinfo
npm-debug.log*
.DS_Store
Thumbs.db
